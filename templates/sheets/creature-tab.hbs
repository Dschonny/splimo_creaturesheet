<section class="tab creature-tab {{tabs.creature.cssClass}}" data-group="primary" data-tab="creature">
    {{#unless hasCreatureInfo}}
    <p class="creature-hint">{{localize "CREATURE.NoCreatureInfo"}}</p>
    {{/unless}}

    {{#if (or creatureInfo.basis creatureInfo.rolle)}}
    <div class="creature-info-box">
        {{#if creatureInfo.basis}}
        <p><strong>{{localize "CREATURE.Basis"}}:</strong>
            <span title="{{creatureInfo.basis.description}}">{{creatureInfo.basis.name}}</span></p>
        {{/if}}
        {{#if creatureInfo.rolle}}
        <p><strong>{{localize "CREATURE.Rolle"}}:</strong>
            <span title="{{creatureInfo.rolle.description}}">{{creatureInfo.rolle.name}}</span></p>
        {{/if}}
    </div>
    {{/if}}

    {{#if verfeinerungenByCategory}}
    <div class="list creature-refinements">
        <div class="list-header">
            <h3>{{localize "CREATURE.Verfeinerungen"}}</h3>
        </div>
        <div class="list-body">
            {{#each verfeinerungenByCategory}}
            <div class="refinement-category">
                <h4>{{localize this.categoryKey}}</h4>
                <ul class="taglist">
                    {{#each this.items}}
                    <li class="taglist-item" title="{{this.description}}">
                        <div class="taglist-item-name">{{this.name}}{{#if this.cost}} ({{this.cost}}){{/if}}</div>
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}

    {{#if abrichtungenByCategory}}
    <div class="list creature-trainings">
        <div class="list-header">
            <h3>{{localize "CREATURE.Abrichtungen"}}</h3>
        </div>
        <div class="list-body">
            {{#each abrichtungenByCategory}}
            <div class="refinement-category">
                <h4>{{localize this.categoryKey}}</h4>
                <ul class="taglist">
                    {{#each this.items}}
                    <li class="taglist-item" title="{{this.description}}">
                        <div class="taglist-item-name">{{this.name}}</div>
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}

    {{#if unassignedMasteries.length}}
    <div class="list unassigned-masteries">
        <div class="list-header">
            <h3>{{localize "CREATURE.UnassignedMasteries"}}: {{localize "splittermond.masteries"}}</h3>
        </div>
        <ul class="list-body taglist">
            {{#each unassignedMasteries}}
            <li class="taglist-item clickable" data-item-id="{{this._id}}" data-action="assign-mastery"
                title="{{localize 'CREATURE.MasteryAssignment.ClickToAssign'}}">
                <div class="taglist-item-name">{{this.name}}</div>
                <div class="taglist-item-actions">
                    <button class="button-inline" data-action="edit-item" type="button">
                        <i class="fa fa-edit" aria-hidden="true"></i>
                    </button>
                    <button class="button-inline" data-action="delete-item" type="button">
                        <i class="fa fa-trash" aria-hidden="true"></i>
                    </button>
                </div>
            </li>
            {{/each}}
        </ul>
    </div>
    {{/if}}

    {{#if unassignedSpells.length}}
    <div class="list unassigned-spells">
        <div class="list-header">
            <h3>{{localize "CREATURE.UnassignedSpells"}}</h3>
        </div>
        <ul class="list-body taglist">
            {{#each unassignedSpells}}
            <li class="taglist-item clickable" data-item-id="{{this._id}}" data-action="assign-spell"
                title="{{localize 'CREATURE.SpellAssignment.ClickToAssign'}}">
                <div class="taglist-item-name">
                    {{this.name}}
                    {{#if this.spellSchool}}
                    <span class="spell-school">[{{this.spellSchool}}{{#if this.spellGrade}} {{this.spellGrade}}{{/if}}]</span>
                    {{/if}}
                </div>
                <div class="taglist-item-actions">
                    <button class="button-inline" data-action="edit-item" type="button">
                        <i class="fa fa-edit" aria-hidden="true"></i>
                    </button>
                    <button class="button-inline" data-action="delete-item" type="button">
                        <i class="fa fa-trash" aria-hidden="true"></i>
                    </button>
                </div>
            </li>
            {{/each}}
        </ul>
    </div>
    {{/if}}
</section>
